# Fathom runs fully offline without any of these. The deterministic pipeline --
# parsing, compiling, validating, the posture graph and the verifier -- never
# makes a network call. Only the natural-language analyst uses a model, and it
# degrades to grounded mode (templated, still verified) when unconfigured.

# Azure OpenAI, per the project specification. Copy this file to .env; it is
# loaded automatically by backend/fathom/config.py. A real exported variable
# always wins over the file.
#
# ENDPOINT: either form works -- a trailing "/openai/v1" (what the Azure portal
# now shows) is trimmed to the resource origin automatically.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
# DEPLOYMENT is the name YOU gave the deployment in Azure AI Foundry, which is
# not necessarily the model name. A resource can list hundreds of deployable
# models and still have zero deployments -- that combination returns
# "DeploymentNotFound". Check: Foundry portal -> your project -> Deployments.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Path to the OPA binary, for the What-If simulator (not required for the MVP).
FATHOM_OPA_BIN=opa

# Where the frontend proxies API calls. Baked in at `next build` time.
FATHOM_API_URL=http://127.0.0.1:8000
